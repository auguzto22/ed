<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Replay15" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/recly_bg_main</item>
        <item name="android:navigationBarColor">@color/recly_bg_main</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/recly_accent_white</item>
        <item name="android:windowBackground">@color/recly_bg_main</item>
    </style>

    <style name="Theme.Replay15.Editor" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/recly_bg_main</item>
        <item name="android:navigationBarColor">@color/recly_bg_main</item>
        <item name="android:colorAccent">@color/recly_accent_white</item>
        <item name="android:windowBackground">@color/recly_bg_main</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Recly.Button" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/recly_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:background">@drawable/recly_pill_secondary</item>
    </style>

    <style name="Recly.QuickButton" parent="Recly.Button">
        <item name="android:minHeight">82dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/recly_card_dark</item>
    </style>
</resources>
