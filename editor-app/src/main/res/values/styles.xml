<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Recly" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorControlActivated">@color/recly_coral</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/recly_bg_main</item>
        <item name="android:navigationBarColor">@color/recly_bg_main</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/recly_coral</item>
        <item name="android:windowBackground">@color/recly_bg_main</item>
    </style>

    <style name="Theme.Recly.Editor" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorControlActivated">@color/recly_coral</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/recly_bg_main</item>
        <item name="android:navigationBarColor">@color/recly_bg_main</item>
        <item name="android:colorAccent">@color/recly_coral</item>
        <item name="android:windowBackground">@color/recly_bg_main</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Recly.Button" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/recly_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:background">@drawable/recly_pill_secondary</item>
    </style>

    <style name="Recly.QuickButton" parent="Recly.Button">
        <item name="android:minHeight">82dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/recly_card_dark</item>
    </style>

    <!-- Campos da tela de conta -->
    <style name="Recly.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/recly_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Recly.Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/rc_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/recly_text_primary</item>
        <item name="android:textColorHint">@color/recly_text_disabled</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAutofill">yes</item>
    </style>

    <style name="Recly.FieldError" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/recly_coral_soft</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
