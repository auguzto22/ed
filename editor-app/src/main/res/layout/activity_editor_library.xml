<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:ignore="UseAppTint">

    <ScrollView
        android:id="@+id/libraryScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="108dp">

            <!-- Cabeçalho do canvas: marca à esquerda, perfil à direita -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/canvas_logo_tile">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_canvas_logo" />
                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnProfile"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/canvas_circle_line"
                    android:clickable="true"
                    android:contentDescription="Perfil"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="M"
                    android:textColor="#FAFAF6"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Título (a palavra "editar" fica amarela, definida no código) -->
            <TextView
                android:id="@+id/homeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.03"
                android:lineSpacingMultiplier="0.95"
                android:text="O que vamos editar hoje?"
                android:textColor="#FAFAF6"
                android:textSize="34sp" />

            <!-- Dois blocos: Novo projeto e Auto Edit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="118dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnNewProject"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/canvas_tile_action"
                    android:clickable="true"
                    android:contentDescription="Novo projeto"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/canvas_circle_ink">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_canvas_plus" />
                    </FrameLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="0.95"
                        android:text="Novo\nprojeto"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnHomeAutoEdit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/canvas_tile_video"
                    android:clickable="true"
                    android:contentDescription="Auto Edit"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/canvas_circle_ink">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_canvas_bolt" />
                    </FrameLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="0.95"
                        android:text="Auto\nEdit"
                        android:textColor="#141414"
                        android:textSize="19sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cartão "Analisar vídeo que vende" -->
            <LinearLayout
                android:id="@+id/btnHomeAnalyze"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/recly_card_dark"
                android:clickable="true"
                android:contentDescription="Analisar vídeo que vende"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/canvas_analyze_box">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_canvas_bars" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Analisar vídeo que vende"
                        android:textColor="#FAFAF6"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingMultiplier="1.1"
                        android:text="Descubra o gancho, o ritmo e o que segura quem assiste."
                        android:textColor="#9A968C"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/canvas_circle_raised">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_canvas_arrow" />
                </FrameLayout>
            </LinearLayout>

            <!-- As abas Projetos / Gravações / Replays ficam na barra de baixo; estes ids seguem existindo. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView android:id="@+id/tabProjects" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <TextView android:id="@+id/tabRecordings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <TextView android:id="@+id/tabReplays" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>

            <!-- Container 1: Projetos Tab -->
            <LinearLayout
                android:id="@+id/containerProjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/recentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02"
                    android:text="Recentes"
                    android:textColor="#FAFAF6"
                    android:textSize="20sp" />

                <!-- Empty State Card -->
                <LinearLayout
                    android:id="@+id/cardEmptyProjects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/recly_card_dark"
                    android:elevation="0dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="26dp">

                    <!-- Glow Circular Badge with Folder -->
                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/recly_circle_glow">

                        <ImageView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_pro_folder_large" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Seu próximo projeto&#10;começa aqui."
                        android:textColor="#FAFAF6"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Importe um vídeo e edite sem&#10;alterar o original."
                        android:textColor="#9A968C"
                        android:textSize="13sp" />

                    <!-- Import Video Button -->
                    <LinearLayout
                        android:id="@+id/btnImportVideo"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/recly_pill_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_pro_upload"
                            android:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Importar vídeo"
                            android:textColor="#FAFAF6"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Security Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_pro_shield"
                            android:tint="#9A968C" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Seus arquivos originais são preservados."
                            android:textColor="#9A968C"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Saved Projects List (when available) -->
                <LinearLayout
                    android:id="@+id/listProjects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Container 2: Gravações Tab -->
            <LinearLayout
                android:id="@+id/containerRecordings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/cardEmptyRecordings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/recly_card_dark"
                    android:elevation="0dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="26dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_pro_video"
                        android:tint="#52525B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Nenhuma gravação ainda"
                        android:textColor="#FAFAF6"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Suas gravações de tela aparecerão aqui."
                        android:textColor="#9A968C"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/listRecordings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Container 3: Replays Tab -->
            <LinearLayout
                android:id="@+id/containerReplays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/cardEmptyReplays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/recly_card_dark"
                    android:elevation="0dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="26dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_save_15"
                        android:tint="#52525B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Nenhum replay salvo"
                        android:textColor="#FAFAF6"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Seus replays instantâneos aparecerão aqui."
                        android:textColor="#9A968C"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/listReplays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Floating Dock with Biblioteca active -->
    <include layout="@layout/recly_bottom_dock" />

</FrameLayout>
