<?xml version="1.0" encoding="utf-8"?>
<!--
    Recly — Conta. Mesmo sistema visual do Início: chão #121214, campos #1C1C1F com linha de 1.5dp,
    coral para a ação principal. Uma tela só, com modos: criar conta, entrar, recuperar senha e
    confirmar e-mail (o código esconde/mostra as partes).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/authRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/recly_bg_main"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:ignore="HardcodedText,Autofill">

    <LinearLayout
        android:id="@+id/authContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Marca -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="BLITZ"
                android:src="@drawable/blitz_mark" />

            <!-- A marca nova vai sem o nome; a view fica (o código ajusta a fonte dela), só escondida. -->
            <TextView
                android:id="@+id/authBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Recly"
                android:textColor="@color/recly_text_primary"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Título -->
        <TextView
            android:id="@+id/authTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:text="Crie sua conta"
            android:textColor="@color/recly_text_primary"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/authSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.15"
            android:text="Seus projetos e presets ficam ligados a você."
            android:textColor="@color/recly_text_secondary"
            android:textSize="15sp" />

        <!-- Aviso (erro geral, sucesso, sessão expirada) -->
        <TextView
            android:id="@+id/authBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/rc_banner"
            android:lineSpacingMultiplier="1.1"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:textColor="@color/recly_text_primary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Formulário -->
        <LinearLayout
            android:id="@+id/authForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/btnGoogle"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/rc_surface"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/labelGoogle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Continuar com Google"
                    android:textColor="@color/recly_text_primary"
                    android:textSize="15sp" />

                <ProgressBar
                    android:id="@+id/progressGoogle"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/recly_text_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/dividerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1.5dp"
                    android:layout_weight="1"
                    android:background="@color/recly_border_subtle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="ou com e-mail"
                    android:textColor="@color/recly_text_disabled"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1.5dp"
                    android:layout_weight="1"
                    android:background="@color/recly_border_subtle" />
            </LinearLayout>

            <!-- Nome -->
            <LinearLayout
                android:id="@+id/fieldNameGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/labelName"
                    style="@style/Recly.FieldLabel"
                    android:labelFor="@+id/inputName"
                    android:text="Nome" />

                <EditText
                    android:id="@+id/inputName"
                    style="@style/Recly.Field"
                    android:autofillHints="name"
                    android:hint="Como podemos te chamar"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="60" />

                <TextView
                    android:id="@+id/errorName"
                    style="@style/Recly.FieldError" />
            </LinearLayout>

            <!-- E-mail -->
            <TextView
                android:id="@+id/labelEmail"
                style="@style/Recly.FieldLabel"
                android:labelFor="@+id/inputEmail"
                android:text="E-mail" />

            <EditText
                android:id="@+id/inputEmail"
                style="@style/Recly.Field"
                android:autofillHints="emailAddress"
                android:hint="voce@email.com"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLength="254" />

            <TextView
                android:id="@+id/errorEmail"
                style="@style/Recly.FieldError" />

            <!-- Senha -->
            <LinearLayout
                android:id="@+id/fieldPasswordGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/labelPassword"
                        style="@style/Recly.FieldLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:labelFor="@+id/inputPassword"
                        android:text="Senha" />

                    <TextView
                        android:id="@+id/linkForgot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:minHeight="36dp"
                        android:gravity="bottom"
                        android:paddingBottom="8dp"
                        android:text="Esqueci a senha"
                        android:textColor="@color/recly_blue_light"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/inputPassword"
                        style="@style/Recly.Field"
                        android:autofillHints="password"
                        android:hint="Sua senha"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLength="72"
                        android:paddingEnd="52dp" />

                    <ImageButton
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="48dp"
                        android:layout_height="52dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Mostrar senha"
                        android:src="@drawable/ic_rc_eye" />
                </FrameLayout>

                <TextView
                    android:id="@+id/errorPassword"
                    style="@style/Recly.FieldError" />

                <TextView
                    android:id="@+id/hintPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pelo menos 8 caracteres, com letras e números."
                    android:textColor="@color/recly_text_disabled"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ação principal -->
        <FrameLayout
            android:id="@+id/btnPrimary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/rc_button_coral_disabled"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/labelPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Criar conta"
                android:textColor="@color/recly_on_accent"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/progressPrimary"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/recly_on_accent"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Ação secundária (reenviar e-mail, voltar) -->
        <TextView
            android:id="@+id/btnSecondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/recly_blue_light"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Alternar entre criar conta e entrar -->
        <LinearLayout
            android:id="@+id/switchRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/switchPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Já tem conta?"
                android:textColor="@color/recly_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/switchLink"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Entrar"
                android:textColor="@color/recly_yellow"
                android:textSize="14sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <TextView
            android:id="@+id/authLegal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="Seus vídeos continuam no seu aparelho. A conta guarda só seu nome e e-mail."
            android:textColor="@color/recly_text_disabled"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnDevSkip"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Continuar sem conta (build de desenvolvimento)"
            android:textColor="@color/recly_text_disabled"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
