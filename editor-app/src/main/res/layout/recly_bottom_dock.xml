<?xml version="1.0" encoding="utf-8"?>
<!-- Menu inferior normal: barra de ponta a ponta presa embaixo (sem ilha flutuante nem pílula).
     O espaço da barra de navegação do sistema entra como padding embaixo (DockNavigationHelper). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomDockContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/home_bottom_bar"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    tools:ignore="UseAppTint">

    <!-- Itens da barra: Início, Editor, + (novo projeto, saltado no meio), Auto Edit e Config. -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 1. Início -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pro_home"
                android:tint="@color/blitz_text" />

            <TextView
                android:id="@+id/navHomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="Início"
                android:textColor="@color/blitz_text"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. Gravações: fora da barra (pedido do Mauro); id mantido para o DockNavigationHelper -->
        <LinearLayout
            android:id="@+id/navRecordings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navRecordingsIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pro_video"
                android:tint="@color/blitz_muted" />

            <TextView
                android:id="@+id/navRecordingsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="Gravações"
                android:textColor="@color/blitz_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3. Editor -->
        <LinearLayout
            android:id="@+id/navEditor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navEditorIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pro_scissors"
                android:tint="@color/blitz_muted" />

            <TextView
                android:id="@+id/navEditorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="Editor"
                android:textColor="@color/blitz_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 4. Botão do meio: novo projeto (círculo vermelho saltado acima da barra) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false">

            <FrameLayout
                android:id="@+id/navNew"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="-18dp"
                android:background="@drawable/home_nav_new"
                android:clickable="true"
                android:contentDescription="Novo projeto"
                android:elevation="6dp"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_canvas_plus"
                    android:tint="#FFFFFF" />
            </FrameLayout>
        </FrameLayout>

        <!-- 5. Auto Edit (atalho; o raio fica sempre vermelho) -->
        <LinearLayout
            android:id="@+id/navAutoEdit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Auto Edit"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_canvas_bolt"
                android:tint="#FFE5163A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="Auto Edit"
                android:textColor="@color/blitz_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 6. Configurações -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pro_gear"
                android:tint="@color/blitz_muted" />

            <TextView
                android:id="@+id/navSettingsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="Config."
                android:textColor="@color/blitz_muted"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Anchors ocultos para compatibilidade com buscas por IDs legados -->
    <LinearLayout android:id="@+id/navRecord" android:layout_width="0dp" android:layout_height="0dp" android:orientation="horizontal" android:visibility="gone" />
    <LinearLayout android:id="@+id/navLibrary" android:layout_width="0dp" android:layout_height="0dp" android:orientation="horizontal" android:visibility="gone" />

</LinearLayout>
