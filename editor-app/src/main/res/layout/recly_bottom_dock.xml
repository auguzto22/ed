<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomDockContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="22dp"
    android:clipChildren="false"
    tools:ignore="UseAppTint">

    <!-- Fundo de ilha flutuante: Vidro preto translúcido, borda prateada sutil de 15% e sombra profunda -->
    <View
        android:id="@+id/bottomDockBg"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="12dp" />

    <!-- Indicador pílula líquida animada deslizante em prata translúcido -->
    <View
        android:id="@+id/liquidPill"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_liquid_pill"
        android:elevation="13dp" />

    <!-- Container dos 4 itens da barra de navegação -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:elevation="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp">

        <!-- 1. Início -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_pro_home"
                android:tint="#F5F5F5" />

            <TextView
                android:id="@+id/navHomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="Início"
                android:textColor="#F5F5F5"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 2. Gravações -->
        <LinearLayout
            android:id="@+id/navRecordings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navRecordingsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_pro_video"
                android:tint="#A5A5AA" />

            <TextView
                android:id="@+id/navRecordingsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="Gravações"
                android:textColor="#A5A5AA"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 3. Editor -->
        <LinearLayout
            android:id="@+id/navEditor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navEditorIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_pro_scissors"
                android:tint="#A5A5AA" />

            <TextView
                android:id="@+id/navEditorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="Editor"
                android:textColor="#A5A5AA"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 4. Configurações -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_pro_gear"
                android:tint="#A5A5AA" />

            <TextView
                android:id="@+id/navSettingsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="Configurações"
                android:textColor="#A5A5AA"
                android:textSize="10.5sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Anchors ocultos para compatibilidade com buscas por IDs legados -->
    <LinearLayout android:id="@+id/navRecord" android:layout_width="0dp" android:layout_height="0dp" android:orientation="horizontal" android:visibility="gone" />
    <LinearLayout android:id="@+id/navLibrary" android:layout_width="0dp" android:layout_height="0dp" android:orientation="horizontal" android:visibility="gone" />

</FrameLayout>
