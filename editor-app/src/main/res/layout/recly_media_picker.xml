<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/recly_bg_main">

    <!-- ── Header ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/pickerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingBottom="@dimen/space_3"
        android:background="@color/recly_bg_main">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/icon_xl"
                android:layout_height="@dimen/icon_xl"
                android:padding="@dimen/space_2"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Voltar"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/recly_text_primary"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Importar Mídia"
                android:textColor="@color/recly_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"/>

            <!-- Album chip -->
            <TextView
                android:id="@+id/albumChip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingHorizontal="@dimen/space_3"
                android:paddingVertical="@dimen/space_1"
                android:text="Todos"
                android:textColor="@color/recly_text_secondary"
                android:textSize="12sp"
                android:background="@drawable/recly_pill_secondary"
                android:gravity="center"
                android:drawableEnd="@drawable/ic_arrow_drop_down"
                android:drawablePadding="2dp"/>

        </LinearLayout>

        <!-- Search bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/recly_pill_search"
            android:paddingHorizontal="@dimen/space_3">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:src="@drawable/ic_search"
                app:tint="@color/recly_text_disabled"/>

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_2"
                android:hint="Buscar mídia..."
                android:textColorHint="@color/recly_text_disabled"
                android:textColor="@color/recly_text_primary"
                android:textSize="14sp"
                android:background="@null"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ── Content ──────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Media grid -->
        <GridView
            android:id="@+id/mediaGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="@null"
            android:drawSelectorOnTop="true"/>

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/loadingIndicator"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/recly_text_secondary"
            android:visibility="gone"/>

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="@dimen/space_8">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_pro_video"
                app:tint="@color/recly_text_disabled"
                android:alpha="0.5"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="Nenhuma mídia encontrada"
                android:textColor="@color/recly_text_secondary"
                android:textSize="16sp"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="Tente buscar com outros termos ou\naltere o álbum selecionado."
                android:textColor="@color/recly_text_disabled"
                android:textSize="13sp"
                android:gravity="center"/>

        </LinearLayout>

        <!-- Permission request -->
        <LinearLayout
            android:id="@+id/permissionView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="@dimen/space_8">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_pro_video"
                app:tint="@color/recly_text_secondary"
                android:alpha="0.5"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="Acesso à galeria"
                android:textColor="@color/recly_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="O Recly precisa de acesso à sua galeria\npara importar fotos e vídeos."
                android:textColor="@color/recly_text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"/>

            <TextView
                android:id="@+id/btnGrantPermission"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/space_6"
                android:paddingHorizontal="@dimen/space_6"
                android:gravity="center"
                android:text="Permitir Acesso"
                android:textColor="@color/recly_bg_main"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/recly_pill_white"/>

        </LinearLayout>

    </FrameLayout>

    <!-- ── Bottom Bar ──────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingVertical="@dimen/space_3"
        android:background="@color/recly_surface">

        <TextView
            android:id="@+id/counterLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nenhum item selecionado"
            android:textColor="@color/recly_text_secondary"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/continueBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="100dp"
            android:paddingHorizontal="@dimen/space_5"
            android:gravity="center"
            android:text="Continuar"
            android:textColor="@color/recly_bg_main"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/recly_pill_white"
            android:alpha="0.5"
            android:enabled="false"
            android:contentDescription="Continuar com a seleção"/>

    </LinearLayout>

</LinearLayout>
