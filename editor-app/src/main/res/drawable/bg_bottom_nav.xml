<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Sombra profunda da ilha flutuante -->
    <item
        android:top="4dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#B3000000" />
            <corners android:radius="34dp" />
        </shape>
    </item>

    <!-- 2. Corpo da cápsula: Fundo preto translúcido (#0D0D0F a 92%) com borda prateada sutil -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#EB131316"
                android:centerColor="#E60D0D0F"
                android:endColor="#EB09090B" />
            <corners android:radius="34dp" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>

    <!-- 3. Iluminação interna suave -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#14FFFFFF"
                android:centerColor="#06FFFFFF"
                android:endColor="#00000000" />
            <corners android:radius="33dp" />
        </shape>
    </item>

    <!-- 4. Reflexo especular prateado sutil na crista superior -->
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="1dp"
        android:height="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2AFFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00000000" />
            <corners
                android:topLeftRadius="33dp"
                android:topRightRadius="33dp" />
        </shape>
    </item>
</layer-list>

