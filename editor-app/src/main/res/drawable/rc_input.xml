<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de texto Recly: superfície com linha de 1.5dp; azul quando focado, coral quando há erro. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#121213" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="#C50022" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#121213" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="#FAFAF6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#121213" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="#2C2C30" />
        </shape>
    </item>
</selector>
