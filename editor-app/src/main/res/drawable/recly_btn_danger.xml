<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33EF4444">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F0241A1C"
                android:centerColor="#E61C1416"
                android:endColor="#E8161012" />
            <stroke
                android:width="1dp"
                android:color="#4DEF4444" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</ripple>
