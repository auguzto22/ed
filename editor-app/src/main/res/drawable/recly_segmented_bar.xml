<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sombra sutil da barra de abas -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- Fundo de vidro escuro translúcido (60% opacidade) -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#B314141A"
                android:centerColor="#990E0E12"
                android:endColor="#8509090C" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#29FFFFFF" />
        </shape>
    </item>

    <!-- Brilho superior specular de chanfro -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="1dp"
        android:height="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#22FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners
                android:topLeftRadius="25dp"
                android:topRightRadius="25dp" />
        </shape>
    </item>
</layer-list>
