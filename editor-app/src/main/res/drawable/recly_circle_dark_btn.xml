<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <layer-list>
            <!-- Sombra suave inferior -->
            <item android:top="2dp">
                <shape android:shape="oval">
                    <solid android:color="#80000000" />
                </shape>
            </item>

            <!-- Corpo circular de vidro translúcido monocromático -->
            <item android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#F0242428"
                        android:centerColor="#E61C1C20"
                        android:endColor="#E8161619" />
                    <stroke
                        android:width="1dp"
                        android:color="#26FFFFFF" />
                </shape>
            </item>

            <!-- Brilho superior especular sutil -->
            <item
                android:left="5dp"
                android:right="5dp"
                android:top="2dp"
                android:bottom="20dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#26FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>

