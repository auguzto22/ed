<?xml version="1.0" encoding="utf-8"?>
<!-- Início: bloco secundário (Auto Edit) na mesma superfície dos cartões, sem brilho creme. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/blitz_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/blitz_surface" />
            <stroke android:width="1dp" android:color="@color/blitz_line" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
