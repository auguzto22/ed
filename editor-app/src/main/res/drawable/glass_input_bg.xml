<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="1.5dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#0C0F172A" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#EAFFFFFF"
                android:centerColor="#D0FFFFFF"
                android:endColor="#B3FFFFFF" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.2dp"
                android:color="#C8FFFFFF" />
        </shape>
    </item>
</layer-list>
