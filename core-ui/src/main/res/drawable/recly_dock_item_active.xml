<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Destaque luminoso e sombra de profundidade ao redor do botão selecionado -->
    <item
        android:top="2dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- 2. Cápsula de vidro iluminada translúcida com borda de 1dp -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#22FFFFFF"
                android:endColor="#18FFFFFF" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#54FFFFFF" />
        </shape>
    </item>

    <!-- 3. Brilho superior especular de chanfro na camada ativa -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="1dp"
        android:height="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#45FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners
                android:topLeftRadius="23dp"
                android:topRightRadius="23dp" />
        </shape>
    </item>
</layer-list>
