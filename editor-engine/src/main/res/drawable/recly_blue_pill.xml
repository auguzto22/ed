<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <!-- Modern dark graphite pill button for primary hero action -->
            <gradient
                android:angle="270"
                android:startColor="#1E2128"
                android:endColor="#111318" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#2C303B" />
        </shape>
    </item>
</ripple>
