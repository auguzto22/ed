<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sombra suave inferior -->
    <item android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#4D000000" />
        </shape>
    </item>

    <!-- Corpo de lente de vidro translúcido -->
    <item android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#B8252530"
                android:centerColor="#99181822"
                android:endColor="#85101016" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>

    <!-- Brilho superior de lente -->
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="2dp"
        android:bottom="18dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
