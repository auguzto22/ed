<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Aura translúcida de brilho vermelho suave -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33EF4444" />
        </shape>
    </item>
    <!-- Núcleo vermelho vivo para gravação ativa -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#EF4444" />
        </shape>
    </item>
</layer-list>
