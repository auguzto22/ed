<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Sombra suave para o pill -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- 2. Corpo do pill em vidro prateado translúcido monocromático -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#5934343A"
                android:centerColor="#4D28282E"
                android:endColor="#401E1E22" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#38FFFFFF" />
        </shape>
    </item>

    <!-- 3. Highlight especular superior -->
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="1dp"
        android:height="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#00000000" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>

